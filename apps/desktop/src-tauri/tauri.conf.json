{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CodingNS",
  "version": "0.2.5",
  "identifier": "com.codingns.desktop",
  "build": {
    "frontendDist": "../../user-app/dist",
    "devUrl": "http://127.0.0.1:4174",
    "beforeDevCommand": "pnpm --dir ../user-app dev -- --host 127.0.0.1 --port 4174",
    "beforeBuildCommand": "pnpm --dir ../user-app build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodingNS",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "acceptFirstMouse": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
