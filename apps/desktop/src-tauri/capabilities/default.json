{
  "identifier": "default",
  "description": "CodingNS desktop default capability",
  "windows": [
    "main",
    "files-*",
    "git-*",
    "processes-*",
    "terminals-*",
    "detach-preview"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
