  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/claude-runtime": {
      "types": "./dist/runtime/claude-runtime.d.ts",
      "import": "./dist/runtime/claude-runtime.js"
