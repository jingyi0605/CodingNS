{
  "name": "codingns-workspace",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "postinstall": "node scripts/fix-node-pty-helper-permissions.cjs && echo '\n✅ 依赖安装完成！现在可以运行开发命令了。\n'",
    "version:sync": "node scripts/sync-version.mjs",
    "docs:dev": "vitepress dev docs/Documentation",
    "docs:build": "vitepress build docs/Documentation",
    "docs:preview": "vitepress preview docs/Documentation",
    "dev": "node -e \"console.log('前后端需要分开启动，分别查看日志。');console.log('后端：npm run dev:backend');console.log('前端：npm run dev:frontend');\"",
    "dev:backend": "node scripts/dev-backend.cjs",
    "dev:backend:tunnel-ui": "node scripts/dev-backend-tunnel-ui.cjs",
    "dev:backend:perf": "node scripts/dev-backend.cjs CODINGNS_PERF_DEBUG=1",
    "dev:frontend": "pnpm --filter user-app dev",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:host": "npm run dev:backend",
    "dev:host:perf": "npm run dev:backend:perf",
    "dev:user-app": "pnpm --dir apps/user-app dev",
    "build:session-sync-core": "pnpm --dir packages/session-sync-core build",
    "build:host": "pnpm --dir packages/session-sync-core build && pnpm --filter host build",
    "build:standalone": "pnpm --dir packages/codingns build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "verify:desktop-ci": "bash scripts/verify-desktop-ci.sh",
    "package:apps": "bash scripts/package-apps.sh",
    "publish:npm": "bash scripts/publish-npm-package.sh",
    "publish:npm:dry-run": "bash scripts/publish-npm-package.sh --dry-run",
    "test:host": "pnpm --dir packages/session-sync-core build && pnpm --filter host test",
    "build:user-app": "pnpm --dir apps/user-app build",
    "test:user-app": "pnpm --dir apps/user-app test"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "vitepress": "^1.6.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@codingns/node-pty",
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "prisma"
    ]
  }
}
