{
  "name": "codingns-workspace",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs && node scripts/ensure-pnpm.cjs",
    "postinstall": "echo '\n✅ 依赖安装完成！现在可以运行开发命令了。\n'",
    "rebuild:native": "node scripts/rebuild-native-modules.cjs",
    "dev": "node scripts/show-dev-help.cjs",
    "dev:backend": "node scripts/dev-backend.cjs",
    "dev:frontend": "pnpm --filter user-app dev",
    "dev:desktop": "corepack pnpm --dir apps/desktop dev",
    "dev:host": "npm run dev:backend",
    "dev:user-app": "corepack pnpm --dir apps/user-app dev",
    "build:session-sync-core": "pnpm --dir packages/session-sync-core build",
    "build:host": "pnpm --dir packages/session-sync-core build && pnpm --filter host build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "test:host": "pnpm --dir packages/session-sync-core build && pnpm --filter host test",
    "build:user-app": "pnpm --dir apps/user-app build",
    "test:user-app": "pnpm --dir apps/user-app test"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
